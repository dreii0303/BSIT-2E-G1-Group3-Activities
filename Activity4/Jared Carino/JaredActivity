<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Personal Data Sheet</title>

<style>
  body {
    font-family: Arial, sans-serif;
    background: #f4f6f8;
  }

  .container {
    width: 80%;
    margin: 30px auto;
    background: white;
    padding: 20px;
    border-radius: 5px;
  }

  .title {
    background: #4169e1;
    color: white;
    padding: 12px;
    border-radius: 4px;
  }

  h3 {
    color: #4169e1;
    margin-top: 20px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }

  .full {
    grid-column: span 2;
  }

  label {
    font-weight: bold;
  }

  input, select {
    width: 100%;
    padding: 8px;
    margin-top: 5px;
  }

  button {
    width: 100%;
    margin-top: 20px;
    padding: 10px;
    background: #4169e1;
    color: white;
    border: none;
    cursor: pointer;
  }

  .output {
    margin-top: 30px;
    padding: 15px;
    border-top: 5px solid #2e8b57;
    display: none;
  }
</style>
</head>

<body>

<div class="container">
  <h2 class="title">Personal Data Sheet</h2>

  <form id="pdsForm">
    <h3>Personal Information</h3>

    <div class="grid">
      <div>
        <label>Full Name</label>
        <input type="text" id="fullname" required>
      </div>

      <div>
        <label>Date of Birth</label>
        <input type="date" id="dob" required>
      </div>

      <div>
        <label>Gender</label>
        <select id="gender" required>
          <option value="">Select Gender</option>
          <option>Male</option>
          <option>Female</option>
          <option>Prefer not to say</option>
        </select>
      </div>

      <div>
        <label>Civil Status</label>
        <select id="status" required>
          <option value="">Select Status</option>
          <option>Single</option>
          <option>Married</option>
          <option>Widowed</option>
        </select>
      </div>
    </div>

    <h3>Contact Information</h3>

    <div class="grid">
      <div>
        <label>Email</label>
        <input type="email" id="email" required>
      </div>

      <div>
        <label>Mobile Number</label>
        <input type="text" id="mobile" required>
      </div>

      <div class="full">
        <label>Complete Address</label>
        <input type="text" id="address" required>
      </div>
    </div>

    <button type="submit">Submit Personal Data Sheet</button>
  </form>

  <div class="output" id="output">
    <h3>Submitted Information</h3>
    <p><b>Full Name:</b> <span id="oName"></span></p>
    <p><b>Date of Birth:</b> <span id="oDob"></span></p>
    <p><b>Gender:</b> <span id="oGender"></span></p>
    <p><b>Status:</b> <span id="oStatus"></span></p>
    <p><b>Email:</b> <span id="oEmail"></span></p>
    <p><b>Mobile:</b> <span id="oMobile"></span></p>
    <p><b>Address:</b> <span id="oAddress"></span></p>
  </div>
</div>

<script>
  // bawal future date
  document.getElementById("dob").max =
    new Date().toISOString().split("T")[0];

  document.getElementById("pdsForm").onsubmit = function(e) {
    e.preventDefault();

    oName.textContent = fullname.value;
    oDob.textContent = dob.value;
    oGender.textContent = gender.value;
    oStatus.textContent = status.value;
    oEmail.textContent = email.value;
    oMobile.textContent = mobile.value;
    oAddress.textContent = address.value;

    document.getElementById("output").style.display = "block";
  };
</script>

</body>
</html>
