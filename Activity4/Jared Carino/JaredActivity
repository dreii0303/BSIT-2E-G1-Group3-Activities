<!DOCTYPE html>
<html>
<head>
  <title>Personal Data Sheet</title>

  <style>
    body {
      font-family: Arial;
      background: #f2f2f2;
    }

    .box {
      width: 70%;
      margin: 20px auto;
      background: white;
      padding: 20px;
      border-radius: 5px;
    }

    input, select, button {
      width: 100%;
      padding: 8px;
      margin-top: 5px;
    }

    button {
      background: green;
      color: white;
      border: none;
      margin-top: 15px;
    }

    .output {
      display: none;
      background: #2e8b57;
      color: white;
      padding: 15px;
      margin-top: 20px;
    }

    .output p {
      background: white;
      color: black;
      padding: 5px;
    }

    .error {
      color: red;
      margin-top: 10px;
    }
  </style>
</head>

<body>

<div class="box">
  <h2>Personal Data Sheet</h2>

  <form onsubmit="showData(event)">
    Full Name:
    <input type="text" id="name">

    Date of Birth:
    <input type="date" id="dob">

    Gender:
    <select id="gender">
      <option value="">Select</option>
      <option>Male</option>
      <option>Female</option>
    </select>

    Status:
    <select id="status">
      <option value="">Select</option>
      <option>Single</option>
      <option>Married</option>
    </select>

    Email:
    <input type="email" id="email">

    Mobile:
    <input type="text" id="mobile">

    Address:
    <input type="text" id="address">

    <button type="submit">Submit</button>

    <p class="error" id="error"></p>
  </form>

  <div class="output" id="output">
    <h3>Submitted Info</h3>
    <p>Name: <span id="oName"></span></p>
    <p>DOB: <span id="oDob"></span></p>
    <p>Gender: <span id="oGender"></span></p>
    <p>Status: <span id="oStatus"></span></p>
    <p>Email: <span id="oEmail"></span></p>
    <p>Mobile: <span id="oMobile"></span></p>
    <p>Address: <span id="oAddress"></span></p>
  </div>
</div>

<script>
function showData(e) {
  e.preventDefault();

  var name = document.getElementById("name").value;
  var dob = document.getElementById("dob").value;
  var gender = document.getElementById("gender").value;
  var status = document.getElementById("status").value;
  var email = document.getElementById("email").value;
  var mobile = document.getElementById("mobile").value;
  var address = document.getElementById("address").value;

  if (name == "" || dob == "" || gender == "" || status == "" ||
      email == "" || mobile == "" || address == "") {
    document.getElementById("error").innerHTML = "Please fill out all fields.";
    return;
  }

  document.getElementById("error").innerHTML = "";

  document.getElementById("oName").innerHTML = name;
  document.getElementById("oDob").innerHTML = dob;
  document.getElementById("oGender").innerHTML = gender;
  document.getElementById("oStatus").innerHTML = status;
  document.getElementById("oEmail").innerHTML = email;
  document.getElementById("oMobile").innerHTML = mobile;
  document.getElementById("oAddress").innerHTML = address;

  document.getElementById("output").style.display = "block";
}
</script>

</body>
</html>
