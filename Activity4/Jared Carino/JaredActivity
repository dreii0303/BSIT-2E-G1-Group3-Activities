<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Personal Data Sheet</title>

<style>
  body {
    font-family: Arial, sans-serif;
    background: #f4f6f8;
  }

  .container {
    width: 80%;
    margin: 30px auto;
    background: white;
    padding: 20px;
    border-radius: 5px;
  }

  .title {
    background: #4169e1;
    color: white;
    padding: 12px;
    border-radius: 4px;
  }

  h3 {
    color: #4169e1;
    margin-top: 20px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }

  .full {
    grid-column: span 2;
  }

  label {
    font-weight: bold;
  }

  input, select {
    width: 100%;
    padding: 8px;
    margin-top: 5px;
  }

  button {
    width: 100%;
    margin-top: 20px;
    padding: 10px;
    background: #4169e1;
    color: white;
    border: none;
    cursor: pointer;
  }

  /* ERROR MESSAGE */
  .error {
    margin-top: 10px;
    color: red;
    font-weight: bold;
  }

  /* GREEN OUTPUT BOX */
  .output {
    margin-top: 30px;
    padding: 20px;
    background: #2e8b57;
    color: white;
    border-radius: 5px;
    display: none;
  }

  .output-content {
    background: white;
    color: black;
    padding: 15px;
    border-radius: 4px;
    margin-top: 10px;
  }
</style>
</head>

<body>

<div class="container">
  <h2 class="title">Personal Data Sheet</h2>

  <form id="pdsForm" novalidate>

    <h3>Personal Information</h3>
    <div class="grid">
      <div>
        <label>Full Name</label>
        <input type="text" id="fullname">
      </div>

      <div>
        <label>Date of Birth</label>
        <input type="date" id="dob">
      </div>

      <div>
        <label>Gender</label>
        <select id="gender">
          <option value="">Select Gender</option>
          <option>Male</option>
          <option>Female</option>
          <option>Prefer not to say</option>
        </select>
      </div>

      <div>
        <label>Civil Status</label>
        <select id="status">
          <option value="">Select Status</option>
          <option>Single</option>
          <option>Married</option>
          <option>Widowed</option>
        </select>
      </div>
    </div>

    <h3>Contact Information</h3>
    <div class="grid">
      <div>
        <label>Email</label>
        <input type="email" id="email">
      </div>

      <div>
        <label>Mobile Number</label>
        <input type="text" id="mobile">
      </div>

      <div class="full">
        <label>Complete Address</label>
        <input type="text" id="address">
      </div>
    </div>

    <button type="submit">Submit Personal Data Sheet</button>

    <!-- CUSTOM ERROR MESSAGE -->
    <div id="errorMsg" class="error"></div>
  </form>

  <div class="output" id="output">
    <h3>Submitted Information</h3>
    <div class="output-content">
      <p><b>Full Name:</b> <span id="oName"></span></p>
      <p><b>Date of Birth:</b> <span id="oDob"></span></p>
      <p><b>Gender:</b> <span id="oGender"></span></p>
      <p><b>Status:</b> <span id="oStatus"></span></p>
      <p><b>Email:</b> <span id="oEmail"></span></p>
      <p><b>Mobile:</b> <span id="oMobile"></span></p>
      <p><b>Address:</b> <span id="oAddress"></span></p>
    </div>
  </div>
</div>

<script>
  // disable future dates
  dob.max = new Date().toISOString().split("T")[0];

  pdsForm.onsubmit = function(e) {
    e.preventDefault();
    errorMsg.textContent = "";

    // PER-FIELD VALIDATION
    if (fullname.value === "") {
      errorMsg.textContent = "Please enter your full name.";
      return;
    }

    if (dob.value === "") {
      errorMsg.textContent = "Please select your date of birth.";
      return;
    }

    if (gender.value === "") {
      errorMsg.textContent = "Please select your gender.";
      return;
    }

    if (status.value === "") {
      errorMsg.textContent = "Please select your civil status.";
      return;
    }

    if (email.value === "") {
      errorMsg.textContent = "Please enter your email.";
      return;
    }

    if (mobile.value === "") {
      errorMsg.textContent = "Please enter your mobile number.";
      return;
    }

    if (address.value === "") {
      errorMsg.textContent = "Please fill out your address.";
      return;
    }

    // ALL OK → show output
    oName.textContent = fullname.value;
    oDob.textContent = dob.value;
    oGender.textContent = gender.value;
    oStatus.textContent = status.value;
    oEmail.textContent = email.value;
    oMobile.textContent = mobile.value;
    oAddress.textContent = address.value;

    output.style.display = "block";
  };
</script>

</body>
</html>
